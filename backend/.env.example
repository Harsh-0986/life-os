# LifeOS backend configuration
# Copy to .env and fill in real values. NEVER commit .env (SPEC §24).

# Required — Gemini API key. Server-side only, never exposed to the browser.
GEMINI_API_KEY=

# Required — the Gemma model identifier. Single source of truth for the model
# name; it must never be hardcoded elsewhere (SPEC §25).
GEMMA_MODEL=gemma-3-27b-it

# Optional — comma-separated list of allowed browser origins.
CORS_ORIGIN=http://localhost:3000

# Optional — how Gemma returns structured output. One of:
#   prompt_json       (default) schema in the prompt + response_mime_type=json
#   function_calling  native tool calling
# prompt_json is the safe default; function_calling is attempted as the
# second and final try when prompt_json fails.
STRUCTURED_OUTPUT_METHOD=prompt_json

# Optional — model temperatures. Analysis stays at 0 for reliable extraction.
ANALYSIS_TEMPERATURE=0
CHAT_TEMPERATURE=0.2